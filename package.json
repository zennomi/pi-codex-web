{
  "name": "pi-codex-web",
  "version": "0.1.0",
  "description": "Native Pi tools backed by Codex's Responses API web search.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "zennomi",
  "keywords": [
    "pi-package",
    "pi",
    "typescript",
    "codex",
    "web-search"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zennomi/pi-codex-web"
  },
  "bugs": {
    "url": "https://github.com/zennomi/pi-codex-web/issues"
  },
  "homepage": "https://github.com/zennomi/pi-codex-web#readme",
  "files": [
    "extensions/codex-web.ts",
    "lib/codex-web.ts",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/codex-web.test.mjs tests/format-table.test.mjs",
    "ci": "npm run typecheck && npm test && npm run pack:check",
    "pack:check": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./extensions/codex-web.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "overrides": {
    "protobufjs": ">=7.6.3 <8.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "^26.6.4",
    "typebox": "latest",
    "typescript": "^7.0.2"
  }
}
